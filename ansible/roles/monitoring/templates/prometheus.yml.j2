# Managed by Ansible
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/alert_rules.yml

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - "{{ hostvars[host].private_ip_address }}:9100"
{% endfor %}

  - job_name: app
    static_configs:
      - targets:
{% for host in groups['role_app'] %}
          - "{{ hostvars[host].private_ip_address }}:{{ app_port }}"
{% endfor %}
